OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
MODEL_DEFAULT=openai/gpt-4o-mini

TELEGRAM_BOT_TOKEN=

# Neon PostgreSQL для долговременной памяти
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=require

# Каталог постоянных данных (загрузки, exports/, backups/, память без БД,
# логи) — на Render/VPS укажи путь на подключённый постоянный диск, иначе
# код (а с ним и process.cwd()) пересоздаётся при каждом деплое и все эти
# данные теряются. Пусто = process.cwd(), как раньше — для локальной
# разработки ничего задавать не обязательно.
DATA_DIR=

# Общий секрет между этим сервером и прокси портфолио (или любым другим
# доверенным клиентом веб-виджета) — обязателен, без него /api/chat,
# /api/upload и /files/* отвечают 503. Сгенерируй случайную строку и
# используй то же значение в AI_AGENT_SHARED_SECRET на стороне портфолио.
WEB_SHARED_SECRET=

# Необязательные лимиты публичного веб-виджета — значения по умолчанию,
# если не заданы: 20 сообщений в час на посетителя, 300 сообщений в день
# суммарно по всем посетителям (защита от неожиданного счёта за API).
PUBLIC_RATE_LIMIT_PER_HOUR=20
PUBLIC_RATE_LIMIT_DAILY_CAP=300

# Сколько дней хранить файлы в backups/ перед автоудалением. По умолчанию 30.
BACKUP_RETENTION_DAYS=30
