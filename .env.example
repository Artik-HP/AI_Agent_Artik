OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
MODEL_DEFAULT=openai/gpt-4o-mini

TELEGRAM_BOT_TOKEN=
# Список chatId через запятую — бот отвечает только им. /whoami в Telegram
# покажет твой chatId. Пусто = отвечает всем (как раньше).
ALLOWED_CHAT_IDS=

# Neon PostgreSQL для долговременной памяти
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=require

# Постоянное хранилище (загрузки, exports/, backups/, память/проекты без
# DATABASE_URL, логи) — полезно на хостинге, который пересобирает код при
# каждом деплое (Render и большинство PaaS). Пусто = process.cwd(), как и
# было — для локальной разработки и текущего запуска на домашнем ПК/VPS
# ничего не меняется.
DATA_DIR=
